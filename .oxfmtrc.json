{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"tabWidth": 2,
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"sortImports": {
		"enabled": true
	},
	"sortPackageJson": {
		"enabled": true
	},
	"ignorePatterns": [
		"**/*.mindle.json",
		"**/.mindle/**",
		"dist",
		"build",
		"coverage",
		"node_modules",
		"**/*.md",
		"docs/**/*.html",
		// Wrangler compares the header literally, including a trailing space Oxfmt strips.
		"packages/tool-host-cloudflare/worker-configuration.gen.d.ts",
		"**/*.gen.ts",
		"**/__generated__/**"
	]
}
