+import net from "node:net";
+export async function listenTrackedTcpForwarder(options) {
+    const acceptedSockets = new Set();
+    const activeTunnels = new Set();
+    let closed = false;
+    const server = net.createServer((socket) => {
+        acceptedSockets.add(socket);
+        socket.once("close", () => acceptedSockets.delete(socket));
+        socket.setNoDelay(true);
+        socket.on("error", () => undefined);
+        void options
+            .openTunnel()
+            .then((tunnel) => {
+            if (closed || socket.destroyed) {
+                tunnel.destroy();
+                return;
+            }
+            activeTunnels.add(tunnel);
+            tunnel.once("close", () => activeTunnels.delete(tunnel));
+            tunnel.on("error", () => socket.destroy());
+            socket.on("error", (error) => tunnel.destroy(error));
+            socket.pipe(tunnel).pipe(socket);
+        })
+            .catch(() => socket.destroy());
+    });
+    await new Promise((resolve, reject) => {
+        server.once("error", reject);
+        server.listen({ host: options.listenHost, port: options.listenPort }, () => {
+            server.off("error", reject);
+            resolve();
+        });
+    });
+    const address = server.address();
+    if (!address || typeof address === "string") {
+        server.close();
+        throw new Error("unexpected local forward server address");
+    }
+    return {
+        host: options.listenHost,
+        port: address.port,
+        close: async () => {
+            if (closed)
+                return;
+            closed = true;
+            for (const socket of acceptedSockets)
+                socket.destroy();
+            acceptedSockets.clear();
+            for (const tunnel of activeTunnels)
+                tunnel.destroy();
+            activeTunnels.clear();
+            await new Promise((resolve) => server.close(() => resolve()));
+        },
+    };
