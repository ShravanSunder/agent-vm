{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"noEmit": true
	},
	"include": ["packages/**/*.ts"],
	"exclude": [
		"packages/**/contract-fixtures/**",
		"packages/**/dist/**",
		"node_modules",
		"packages/**/*.test.ts",
		"packages/**/*.spec.ts",
		"packages/**/*-test-fixture.ts"
	]
}
