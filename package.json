{
	"name": "agent-vm-workspace",
	"version": "0.0.1",
	"private": true,
	"description": "Sandboxed VM controller, worker, and gateway packages for autonomous coding agents",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"clean": "git clean -fdX packages",
		"check:package-versions": "bash scripts/check-package-version-sync.sh",
		"check:zod": "node scripts/check-zod-version.ts",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix",
		"lint:types": "oxlint --type-aware .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
		"check": "pnpm check:package-versions && pnpm check:zod && pnpm lint:types && pnpm fmt:check && pnpm typecheck",
		"test": "pnpm test:unit",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:integration:llm": "vitest run --config vitest.llm-integration.config.ts",
		"test:smoke": "vitest run --config vitest.smoke.config.ts",
		"test:watch": "vitest",
		"perf:gondolin-vfs": "node scripts/perf/gondolin-vfs-benchmark.ts",
		"perf:worker-git": "node scripts/perf/gondolin-worker-git-benchmark.ts"
	},
	"devDependencies": {
		"@types/node": "^25.6.2",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"oxlint-tsgolint": "^0.22.1",
		"tasuku": "^2.3.0",
		"tsdown": "^0.22.0",
		"tsx": "4.21.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.11",
		"vitest": "^4.1.5"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.33.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"patchedDependencies": {
			"@earendil-works/gondolin@0.9.1": "patches/@earendil-works__gondolin@0.9.1.patch"
		}
	}
}
