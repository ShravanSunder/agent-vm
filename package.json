{
	"name": "agent-vm-workspace",
	"version": "0.0.1",
	"private": true,
	"description": "Sandboxed VM controller, worker, and gateway packages for autonomous coding agents",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"clean": "git clean -fdX packages",
		"check:package-versions": "bash scripts/check-package-version-sync.sh",
		"check:zod": "node scripts/check-zod-version.ts",
		"test:taxonomy": "tsx scripts/audit-test-taxonomy.ts",
		"test:portal-architecture": "tsx scripts/audit-portal-architecture.ts",
		"test:portal-exports": "tsx scripts/verify-portal-package-exports.ts",
		"test:vm-ownership-boundaries": "tsx scripts/audit-vm-ownership-boundaries.ts",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix",
		"lint:types": "oxlint --type-aware .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
		"check": "tsx scripts/run-check-gate.ts",
		"test": "pnpm test:unit",
		"test:unit": "pnpm test:taxonomy && vitest run --config vitest.config.ts --project unit",
		"test:integration": "vitest run --config vitest.config.ts --project integration",
		"test:e2e:host-docker": "tsx scripts/run-vitest-evidence-project.ts e2e-host-docker",
		"test:e2e:host": "tsx scripts/run-vitest-evidence-project.ts e2e-host",
		"test:e2e:inventory": "vitest run --config vitest.config.ts --project e2e-inventory",
		"test:e2e:vm": "AGENT_VM_GONDOLIN_E2E=1 tsx scripts/run-vitest-evidence-project.ts e2e-vm",
		"test:e2e:vm-mediation": "AGENT_VM_GONDOLIN_E2E=1 tsx scripts/run-vitest-evidence-project.ts e2e-vm-mediation",
		"test:e2e:openclaw": "AGENT_VM_OPENCLAW_E2E=1 tsx scripts/run-vitest-evidence-project.ts e2e-openclaw",
		"test:e2e:control-lease-reliability": "AGENT_VM_GONDOLIN_E2E=1 AGENT_VM_OPENCLAW_E2E=1 tsx scripts/run-control-lease-reliability-proof.ts",
		"test:e2e:worker": "AGENT_VM_WORKER_E2E=1 tsx scripts/run-vitest-evidence-project.ts e2e-worker",
		"test:e2e:secrets": "AGENT_VM_1PASSWORD_E2E=1 tsx scripts/run-vitest-evidence-project.ts e2e-secrets",
		"test:e2e:llm": "AGENT_VM_LLM_E2E=1 tsx scripts/run-vitest-evidence-project.ts e2e-llm",
		"test:e2e": "tsx scripts/run-e2e-proof-lanes.ts",
		"test:watch": "vitest",
		"dev:sync-tarballs": "tsx scripts/sync-local-tarballs-to-deployment.ts",
		"perf:gondolin-vfs": "node scripts/perf/gondolin-vfs-benchmark.ts",
		"perf:worker-git": "node scripts/perf/gondolin-worker-git-benchmark.ts"
	},
	"devDependencies": {
		"@types/node": "^25.6.2",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"oxlint-tsgolint": "^0.22.1",
		"tasuku": "^2.3.0",
		"tsdown": "^0.22.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.11",
		"vitest": "^4.1.5"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.33.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"patchedDependencies": {
			"@earendil-works/gondolin@0.12.0": "patches/@earendil-works__gondolin@0.12.0.patch"
		}
	}
}
