{
  "private": true,
  "type": "module",
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shadcn/lint": "0.2.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "esbuild": "0.27.7",
    "lucide-react": "1.59.0",
    "next-themes": "^0.4.6",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "node build-review.mjs && tailwindcss -i src/bridge-theme.css -o public/app.css --minify",
    "start": "tsx src/review-server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src",
    "format": "oxfmt src build-review.mjs components.json public/index.html",
    "format:check": "oxfmt --check src build-review.mjs components.json public/index.html"
  },
  "packageManager": "pnpm@12.14.0"
}
