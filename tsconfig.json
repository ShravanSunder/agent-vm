{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"noEmit": true
	},
	"include": ["packages/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "vitest.setup.ts"],
	"exclude": [
		"packages/**/contract-fixtures/**",
		"packages/**/dist/**",
		"node_modules",
		"packages/tool-host-cloudflare/**",
		"packages/auth/**"
	]
}
