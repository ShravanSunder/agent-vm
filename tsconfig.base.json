{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2024"],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"useUnknownInCatchVariables": true,
		"alwaysStrict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": {
			"@agent-vm/agent-vm": ["./packages/agent-vm/src/index.ts"],
			"@agent-vm/config-contracts": ["./packages/config-contracts/src/index.ts"],
			"@agent-vm/gondolin-adapter": ["./packages/gondolin-adapter/src/index.ts"],
			"@agent-vm/agent-vm-worker": ["./packages/agent-vm-worker/src/index.ts"],
			"@agent-vm/gateway-interface": ["./packages/gateway-interface/src/index.ts"],
			"@agent-vm/openclaw-agent-vm-plugin": ["./packages/openclaw-agent-vm-plugin/src/index.ts"],
			"@agent-vm/mcp-portal": ["./packages/mcp-portal/src/index.ts"],
			"@agent-vm/mcp-portal/core": ["./packages/mcp-portal/src/core/index.ts"],
			"@agent-vm/mcp-portal/mcp-proxy": ["./packages/mcp-portal/src/mcp-proxy/index.ts"],
			"@agent-vm/mcp-portal/cli": ["./packages/mcp-portal/src/cli/index.ts"],
			"@agent-vm/mcp-portal/testing/fake-upstream-mcp-server": [
				"./packages/mcp-portal/src/testing/fake-upstream-mcp-server.ts"
			],
			"@agent-vm/openclaw-mcp-portal-plugin": [
				"./packages/openclaw-mcp-portal-plugin/src/index.ts"
			],
			"@agent-vm/openclaw-gateway": ["./packages/openclaw-gateway/src/index.ts"],
			"@agent-vm/secrets": ["./packages/secrets/src/index.ts"],
			"@agent-vm/worker-gateway": ["./packages/worker-gateway/src/index.ts"]
		}
	}
}
