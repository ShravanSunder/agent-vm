{
	"name": "@agent-vm/tool-portal",
	"version": "0.0.141",
	"description": "Cross-backend capability service and explicitly configured standalone projections.",
	"homepage": "https://github.com/ShravanSunder/agent-vm#readme",
	"bugs": {
		"url": "https://github.com/ShravanSunder/agent-vm/issues"
	},
	"license": "MIT",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/tool-portal"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cli-allowances": {
			"types": "./dist/cli-allowances/index.d.ts",
			"import": "./dist/cli-allowances/index.js"
		},
		"./dispatch-authority": {
			"types": "./dist/dispatch-authority.d.ts",
			"import": "./dist/dispatch-authority.js"
		},
		"./standalone-entrypoint": {
			"types": "./dist/standalone-entrypoint/index.d.ts",
			"import": "./dist/standalone-entrypoint/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "pnpm -C ../.. build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm test:unit",
		"test:unit": "vitest run --root ../../ --config vitest.config.ts --project unit packages/tool-portal/src"
	},
	"dependencies": {
		"@agent-vm/agent-portal-sdk": "workspace:*",
		"@agent-vm/config-contracts": "workspace:*",
		"@agent-vm/controller-execution-contracts": "workspace:*",
		"@agent-vm/gateway-control-contracts": "workspace:*",
		"@agent-vm/mcp-portal": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"vitest": "^4.1.5"
	}
}
