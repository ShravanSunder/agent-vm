{
	"name": "@agent-vm/agent-vm",
	"version": "0.0.114",
	"description": "Controller CLI and HTTP server for sandboxed VM coding agents.",
	"homepage": "https://github.com/ShravanSunder/agent-vm#readme",
	"bugs": {
		"url": "https://github.com/ShravanSunder/agent-vm/issues"
	},
	"license": "MIT",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/agent-vm"
	},
	"bin": {
		"agent-vm": "./dist/cli/agent-vm-entrypoint.js"
	},
	"files": [
		"dist",
		"managed-images.json"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "pnpm -C ../.. build",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@agent-vm/agent-vm-worker": "workspace:*",
		"@agent-vm/config-contracts": "workspace:*",
		"@agent-vm/control-protocol-contracts": "workspace:*",
		"@agent-vm/gateway-control-contracts": "workspace:*",
		"@agent-vm/gateway-lifecycle": "workspace:*",
		"@agent-vm/gondolin-vm-adapter": "workspace:*",
		"@agent-vm/managed-vm": "workspace:*",
		"@agent-vm/mcp-portal": "workspace:*",
		"@agent-vm/openclaw-agent-vm-plugin": "workspace:*",
		"@agent-vm/openclaw-gateway": "workspace:*",
		"@agent-vm/secret-management": "workspace:*",
		"@agent-vm/worker-control-contracts": "workspace:*",
		"@agent-vm/worker-gateway": "workspace:*",
		"@hono/node-server": "^2.0.2",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/api-logs": "0.219.0",
		"@opentelemetry/exporter-logs-otlp-proto": "0.219.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "0.219.0",
		"@opentelemetry/exporter-trace-otlp-proto": "0.219.0",
		"@opentelemetry/resources": "2.8.0",
		"@opentelemetry/sdk-logs": "0.219.0",
		"@opentelemetry/sdk-metrics": "2.8.0",
		"@opentelemetry/sdk-trace-base": "2.8.0",
		"@opentelemetry/semantic-conventions": "1.41.1",
		"ansis": "^4.3.0",
		"cmd-ts": "^0.15.0",
		"execa": "^9.6.1",
		"hono": "^4.12.18",
		"jsonc-parser": "^3.3.1",
		"socket.io-client": "4.8.1",
		"tasuku": "^2.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"socket.io": "4.8.1"
	}
}
