{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noEmit": false,
		"paths": {
			"@agent-vm/agent-vm-worker": ["../agent-vm-worker/dist/index.d.ts"],
			"@agent-vm/config-contracts": ["../config-contracts/dist/index.d.ts"],
			"@agent-vm/gateway-lifecycle": ["../gateway-lifecycle/dist/index.d.ts"],
			"@agent-vm/gondolin-vm-adapter": ["../gondolin-vm-adapter/dist/index.d.ts"],
			"@agent-vm/managed-vm": ["../managed-vm/dist/index.d.ts"],
			"@agent-vm/mcp-portal": ["../mcp-portal/dist/index.d.ts"],
			"@agent-vm/secret-management": ["../secret-management/dist/index.d.ts"],
			"@agent-vm/tool-portal/cli-allowances": ["../tool-portal/dist/cli-allowances/index.d.ts"],
			"@agent-vm/worker-gateway": ["../worker-gateway/dist/index.d.ts"]
		}
	},
	"exclude": [
		"src/**/*.test.ts",
		"src/testing/**",
		"src/integration-tests/gateway-runtime-sandbox-test-fixture.ts",
		"src/integration-tests/gateway-runtime-sandbox-vm-test-fixture.ts"
	]
}
