{
	"name": "@agent-collaboration/tool-engine",
	"version": "0.0.153",
	"description": "Portable capability dispatch over resource-owned backends and approval ports.",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"imports": {
		"#dispatch/*": "./src/dispatch/*.ts"
	},
	"exports": {
		"./dispatch": {
			"types": "./dist/dispatch/index.d.ts",
			"import": "./dist/dispatch/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.production.json --noEmit",
		"test": "vitest run --root ../../ --config vitest.config.ts --project unit packages/tool-engine/src"
	},
	"dependencies": {
		"@agent-collaboration/tool-access": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"vitest": "^4.1.5"
	}
}
