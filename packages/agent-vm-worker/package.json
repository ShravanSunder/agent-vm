{
	"name": "@agent-vm/agent-vm-worker",
	"version": "0.0.116",
	"description": "Worker process that runs inside a sandboxed VM, plans, edits, validates, and reviews coding tasks.",
	"homepage": "https://github.com/ShravanSunder/agent-vm#readme",
	"bugs": {
		"url": "https://github.com/ShravanSunder/agent-vm/issues"
	},
	"license": "MIT",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/agent-vm-worker"
	},
	"bin": {
		"agent-vm-worker": "./dist/main.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm test:unit",
		"test:unit": "vitest run --root ../../ --config vitest.config.ts --project unit packages/agent-vm-worker/src",
		"test:integration": "vitest run --root ../../ --config vitest.config.ts --project integration packages/agent-vm-worker/src",
		"test:e2e:worker": "AGENT_VM_WORKER_E2E=1 tsx ../../scripts/run-vitest-evidence-project.ts e2e-worker packages/agent-vm-worker/src",
		"start": "node ./dist/main.js"
	},
	"dependencies": {
		"@agent-vm/control-protocol-contracts": "workspace:*",
		"@agent-vm/gateway-lifecycle": "workspace:*",
		"@agent-vm/worker-control-contracts": "workspace:*",
		"@hono/node-server": "^2.0.2",
		"@hono/zod-validator": "^0.8.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@openai/codex-sdk": "^0.142.5",
		"cmd-ts": "^0.15.0",
		"engine.io": "6.6.9",
		"execa": "^9.6.1",
		"hono": "^4.12.18",
		"jsonc-parser": "^3.3.1",
		"socket.io": "4.8.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"socket.io-client": "4.8.1",
		"vitest": "^4.1.5"
	}
}
