{
	"name": "__WORKER_NAME__",
	"account_id": "__ACCOUNT_ID__",
	"main": "__PORTAL_ENTRY__",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"workers_dev": "__WORKERS_DEV__",
	"preview_urls": false,
	"routes": [],
	"durable_objects": {
		"bindings": [{ "name": "WORKSPACES", "class_name": "WorkspaceAuthority" }]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["OrganizationAuthorization"] },
		{
			"tag": "v2",
			"renamed_classes": [{ "from": "OrganizationAuthorization", "to": "WorkspaceAuthority" }]
		}
	],
	"analytics_engine_datasets": [
		{ "binding": "CALL_ANALYTICS", "dataset": "__ANALYTICS_DATASET__" }
	],
	"vars": "__PORTAL_VARIABLES__",
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}
