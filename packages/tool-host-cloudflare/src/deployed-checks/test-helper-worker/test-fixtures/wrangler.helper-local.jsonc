{
	"name": "controlled-helper-local",
	"main": "local-helper-entrypoint.ts",
	"compatibility_date": "2025-09-24",
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{ "name": "WORKSPACES", "class_name": "WorkspaceAuthority" },
			{ "name": "OBSERVATIONS", "class_name": "TestObservations" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["OrganizationAuthorization", "TestObservations"] },
		{
			"tag": "v2",
			"renamed_classes": [{ "from": "OrganizationAuthorization", "to": "WorkspaceAuthority" }],
		},
	],
}
