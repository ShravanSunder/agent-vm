{
	"name": "@agent-collaboration/tool-host-cloudflare",
	"version": "0.0.153",
	"description": "Organization-scoped Tool Portal host for Cloudflare Workers.",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"imports": {
		"#worker-host/*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --root ../../ --config vitest.config.ts --project unit packages/tool-host-cloudflare/src",
		"dev": "wrangler dev --local --config wrangler.local.jsonc"
	},
	"dependencies": {
		"@agent-collaboration/tool-access": "workspace:*",
		"@agent-collaboration/tool-engine": "workspace:*",
		"@modelcontextprotocol/core": "2.3.1",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@modelcontextprotocol/server": "2.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@agent-collaboration/tool-host-node": "workspace:*",
		"@cloudflare/workers-types": "4.20250927.0",
		"@modelcontextprotocol/client": "2.3.1",
		"esbuild": "0.27.7",
		"jose": "6.1.0",
		"miniflare": "5.20260815.0-alpha",
		"vitest": "4.1.5",
		"wrangler": "4.124.0"
	}
}
