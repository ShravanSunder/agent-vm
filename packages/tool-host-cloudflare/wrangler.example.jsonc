{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tool-portal-local",
	"main": "dist/index.js",
	"compatibility_date": "2025-09-24",
	"vars": {
		"ORGANIZATION_CONFIGURATIONS": "{}",
		"SIGN_IN_ISSUER": "https://sign-in.example.invalid",
		"SIGN_IN_JWKS_URL": "https://sign-in.example.invalid/jwks",
		"TOOL_PORTAL_AUDIENCE": "replace-with-portal-audience",
	},
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [{ "name": "ORGANIZATIONS", "class_name": "OrganizationAuthorization" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrganizationAuthorization"] }],
	"analytics_engine_datasets": [{ "binding": "CALL_ANALYTICS", "dataset": "tool_portal_local" }],
}
