{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tool-portal-local",
	"main": "dist/index.js",
	"compatibility_date": "2025-09-24",
	"services": [
		{
			"binding": "SIGN_IN",
			"service": "agent-sign-in-example",
			"entrypoint": "AgentClientManagement",
		},
	],
	"vars": {
		"MANAGEMENT_AUDIENCE": "replace-with-management-audience",
		"WORKSPACE_CONFIGURATIONS": "{}",
		"SIGN_IN_ISSUER": "https://sign-in.example.invalid",
		"SIGN_IN_JWKS_URL": "https://sign-in.example.invalid/jwks",
		"TOOL_PORTAL_ORIGIN": "https://portal.example.invalid",
	},
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [{ "name": "WORKSPACES", "class_name": "WorkspaceAuthority" }],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["OrganizationAuthorization"] },
		{
			"tag": "v2",
			"renamed_classes": [{ "from": "OrganizationAuthorization", "to": "WorkspaceAuthority" }],
		},
	],
	"analytics_engine_datasets": [{ "binding": "CALL_ANALYTICS", "dataset": "tool_portal_local" }],
}
