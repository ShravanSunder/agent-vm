			"bootId": {
				"type": "string",
				"minLength": 1
			},
			"controllerEpoch": {
				"type": "string",
				"minLength": 1
			},
			"credentialId": {
				"type": "string",
				"minLength": 1
			},
			"expiresAtMs": {
				"type": "integer",
				"exclusiveMinimum": 0,
				"maximum": 9007199254740991
			},
			"generationId": {
				"type": "string",
				"minLength": 1
			},
			"issuedAtMs": {
				"type": "integer",
				"exclusiveMinimum": 0,
				"maximum": 9007199254740991
			},
			"nonce": {
				"type": "string",
				"minLength": 16
			},
			"peerId": {
				"type": "string",
				"minLength": 1
			},
			"protocolVersion": {
				"type": "number",
				"const": 1
			},
			"zoneId": {
				"type": "string",
				"minLength": 1
			}
		},
		"required": [
			"audience",
			"bootId",
			"controllerEpoch",
			"credentialId",
			"expiresAtMs",
			"generationId",
			"issuedAtMs",
			"nonce",
			"peerId",
			"protocolVersion",
			"zoneId"
		],
		"additionalProperties": false
	},
