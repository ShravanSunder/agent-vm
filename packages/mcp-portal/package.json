{
	"name": "@agent-vm/mcp-portal",
	"version": "0.0.70",
	"description": "Agent-scoped MCP Portal server and TypeScript helpers for composable upstream MCP tools.",
	"homepage": "https://github.com/ShravanSunder/agent-vm#readme",
	"bugs": {
		"url": "https://github.com/ShravanSunder/agent-vm/issues"
	},
	"license": "MIT",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/mcp-portal"
	},
	"bin": {
		"agent-vm-mcp-portal": "./dist/bin/agent-vm-mcp-portal.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./mcp-proxy": {
			"types": "./dist/mcp-proxy/index.d.ts",
			"import": "./dist/mcp-proxy/index.js"
		},
		"./cli": {
			"types": "./dist/cli/index.d.ts",
			"import": "./dist/cli/index.js"
		},
		"./tool-vm": {
			"types": "./dist/tool-vm/index.d.ts",
			"import": "./dist/tool-vm/index.js"
		},
		"./auth/hmac-token": {
			"types": "./dist/auth/hmac-token.d.ts",
			"import": "./dist/auth/hmac-token.js"
		},
		"./auth/hmac-env": {
			"types": "./dist/auth/hmac-env.d.ts",
			"import": "./dist/auth/hmac-env.js"
		},
		"./auth/agent-bearer-token": {
			"types": "./dist/auth/agent-bearer-token.d.ts",
			"import": "./dist/auth/agent-bearer-token.js"
		},
		"./testing/fake-upstream-mcp-server": {
			"types": "./dist/testing/fake-upstream-mcp-server.d.ts",
			"import": "./dist/testing/fake-upstream-mcp-server.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "pnpm -C ../.. build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm test:unit",
		"test:unit": "vitest run --root ../../ --config vitest.config.ts packages/mcp-portal/src"
	},
	"dependencies": {
		"@agent-vm/config-contracts": "workspace:*",
		"@agent-vm/secrets": "workspace:*",
		"@hono/node-server": "^2.0.2",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"hono": "^4.12.18",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"vitest": "^4.1.5"
	}
}
