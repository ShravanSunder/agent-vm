{
	"name": "@agent-vm/controller-execution-contracts",
	"version": "0.0.147",
	"description": "Zod contracts for controller-owned portal execution boundaries.",
	"homepage": "https://github.com/ShravanSunder/agent-vm#readme",
	"bugs": {
		"url": "https://github.com/ShravanSunder/agent-vm/issues"
	},
	"license": "MIT",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/controller-execution-contracts"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./controller-dispatch-boundary": {
			"types": "./dist/controller-dispatch-boundary/index.d.ts",
			"import": "./dist/controller-dispatch-boundary/index.js"
		},
		"./controller-execution-data-boundary": {
			"types": "./dist/controller-execution-data-boundary/index.d.ts",
			"import": "./dist/controller-execution-data-boundary/index.js"
		},
		"./controller-execution-request-boundary": {
			"types": "./dist/controller-execution-request-boundary/index.d.ts",
			"import": "./dist/controller-execution-request-boundary/index.js"
		},
		"./oauth-authorization-boundary": {
			"types": "./dist/oauth-authorization-boundary/index.d.ts",
			"import": "./dist/oauth-authorization-boundary/index.js"
		},
		"./tool-vm-runner-boundary": {
			"types": "./dist/tool-vm-runner-boundary/index.d.ts",
			"import": "./dist/tool-vm-runner-boundary/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "pnpm -C ../.. build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm test:unit",
		"test:unit": "vitest run --root ../../ --config vitest.config.ts --project unit packages/controller-execution-contracts/src"
	},
	"dependencies": {
		"@agent-vm/agent-portal-sdk": "workspace:*",
		"@agent-vm/oauth-broker-contracts": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"vitest": "^4.1.5"
	}
}
