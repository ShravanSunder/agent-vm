{
	"name": "@agent-vm/oauth-approval-ui",
	"version": "0.0.148",
	"description": "Server-rendered OAuth approval pages and bounded browser islands.",
	"homepage": "https://github.com/ShravanSunder/agent-vm#readme",
	"bugs": {
		"url": "https://github.com/ShravanSunder/agent-vm/issues"
	},
	"license": "MIT",
	"author": "Shravan Sunder <ShravanSunder@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/oauth-approval-ui"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown && tailwindcss -i src/styles/oauth.css -o dist/assets/oauth.css --minify && tsx scripts/fingerprint-assets.ts",
		"prepack": "pnpm -C ../.. build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --root ../../ --config vitest.config.ts --project unit packages/oauth-approval-ui/src"
	},
	"dependencies": {
		"@agent-vm/oauth-broker-contracts": "workspace:*",
		"hono": "4.12.24",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"esbuild": "^0.27.7",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.21.0",
		"vitest": "^4.1.5"
	}
}
