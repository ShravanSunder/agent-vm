	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/gondolin-vm-adapter"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
