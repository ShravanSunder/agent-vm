{
	"name": "@agent-collaboration/auth",
	"version": "0.0.153",
	"description": "Audience-bound person and agent sign-in with a portable core and Cloudflare adapter.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/auth"
	},
	"files": [
		"dist",
		"migrations",
		"worker-configuration.gen.d.ts",
		"wrangler.example.jsonc"
	],
	"type": "module",
	"imports": {
		"#auth/*": "./src/*.ts"
	},
	"exports": {
		"./core": {
			"types": "./dist/sign-in-core/index.d.ts",
			"import": "./dist/sign-in-core/index.js"
		},
		"./cloudflare": {
			"types": "./dist/cloudflare-host/index.d.ts",
			"import": "./dist/cloudflare-host/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"types:generate": "wrangler types worker-configuration.gen.d.ts --config wrangler.example.jsonc --env-interface AuthWorkerEnv --strict-vars=false",
		"types:check": "wrangler types worker-configuration.gen.d.ts --config wrangler.example.jsonc --env-interface AuthWorkerEnv --strict-vars=false --check",
		"build": "tsdown",
		"typecheck": "pnpm types:check && tsc -p tsconfig.json --noEmit",
		"test": "vitest run --root ../../ --config vitest.config.ts --project unit packages/auth/src"
	},
	"dependencies": {
		"@agent-collaboration/tool-access": "workspace:*",
		"@better-auth/core": "1.7.11",
		"@better-auth/kysely-adapter": "1.7.11",
		"@better-auth/oauth-provider": "1.7.11",
		"@better-auth/passkey": "1.7.11",
		"better-auth": "1.7.11",
		"jose": "6.2.12",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"esbuild": "0.28.1",
		"miniflare": "5.20260815.0-alpha",
		"vitest": "4.1.5",
		"wrangler": "4.124.0"
	}
}
