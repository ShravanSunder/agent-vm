{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-sign-in-example",
	"main": "dist/cloudflare-host/index.js",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "replace-with-sign-in-database",
			"database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "migrations",
		},
	],
	"vars": {
		"SIGN_IN_CONFIGURATION": "replace-with-private-deployment-configuration",
		"AUTH_SECRET": "replace-with-worker-secret",
		"GOOGLE_CLIENT_ID": "replace-with-provider-client",
		"GOOGLE_CLIENT_SECRET": "replace-with-worker-secret",
		"GITHUB_CLIENT_ID": "replace-with-provider-client",
		"GITHUB_CLIENT_SECRET": "replace-with-worker-secret",
	},
}
