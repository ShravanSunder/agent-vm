{
	"id": "gondolin",
	"name": "Gondolin VM Sandbox",
	"description": "Sandbox backend powered by Gondolin micro-VMs, Tool Portal tools, and private agent-vm control sessions.",
	"cliBackends": ["gondolin"],
	"activation": {
		"onStartup": true
	},
	"contracts": {
		"tools": ["tool_portal_list", "tool_portal_search", "tool_portal_describe", "tool_portal_call"]
	},
	"toolMetadata": {
		"tool_portal_list": {
			"optional": true
		},
		"tool_portal_search": {
			"optional": true
		},
		"tool_portal_describe": {
			"optional": true
		},
		"tool_portal_call": {
			"optional": true
		}
	},
	"configSchema": {
		"type": "object",
		"additionalProperties": false,
		"properties": {
			"zoneId": {
				"type": "string",
				"minLength": 1
			},
			"controlSession": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"bootId": {
						"type": "string",
						"minLength": 1
					},
					"controllerEpoch": {
						"type": "string",
						"minLength": 1
					},
					"generationId": {
						"type": "string",
						"minLength": 1
					},
					"peerId": {
						"type": "string",
						"minLength": 1
					},
					"verifierPublicKeyPem": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": ["bootId", "controllerEpoch", "generationId", "peerId", "verifierPublicKeyPem"]
			},
			"profileId": {
				"type": "string",
				"minLength": 1
			},
			"toolPortal": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"configDir": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": ["configDir"]
			},
			"zoneGitToken": {
				"type": "string",
				"minLength": 1
			},
			"zoneGitTokenEnv": {
				"type": "string",
				"minLength": 1
			}
		},
		"required": ["zoneId"]
	}
}
