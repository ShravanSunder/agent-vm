{
	"id": "gondolin",
	"name": "Gondolin VM Sandbox",
	"description": "Thin OpenClaw adapter for the agent-vm Gateway Runtime Tool Portal service.",
	"activation": {
		"onStartup": true
	},
	"contracts": {
		"tools": ["tool_portal_list", "tool_portal_search", "tool_portal_describe", "tool_portal_call"]
	},
	"toolMetadata": {
		"tool_portal_list": {
			"optional": true
		},
		"tool_portal_search": {
			"optional": true
		},
		"tool_portal_describe": {
			"optional": true
		},
		"tool_portal_call": {
			"optional": true
		}
	},
	"configSchema": {
		"type": "object",
		"additionalProperties": false,
		"properties": {
			"zoneId": {
				"type": "string",
				"minLength": 1
			},
			"toolPortal": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"attachment": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"attachmentGeneration": {
								"type": "integer",
								"minimum": 1,
								"maximum": 9007199254740991
							},
							"clientKind": {
								"const": "openclaw-managed-plugin"
							},
							"configuredAgentIds": {
								"type": "array",
								"minItems": 1,
								"maxItems": 128,
								"uniqueItems": true,
								"items": {
									"type": "string",
									"minLength": 1,
									"maxLength": 256
								}
							},
							"frameworkEpoch": {
								"type": "string",
								"minLength": 1,
								"maxLength": 256
							},
							"gatewayEpoch": {
								"type": "string",
								"minLength": 1,
								"maxLength": 256
							},
							"protocolVersion": {
								"type": "integer",
								"minimum": 1,
								"maximum": 9007199254740991
							},
							"projectionCohortDigest": {
								"type": "string",
								"pattern": "^projection-cohort:[a-f0-9]{64}$"
							},
							"runtimeEpoch": {
								"type": "string",
								"minLength": 1,
								"maxLength": 256
							},
							"schemaVersion": {
								"type": "integer",
								"minimum": 1,
								"maximum": 9007199254740991
							}
						},
						"required": [
							"attachmentGeneration",
							"clientKind",
							"configuredAgentIds",
							"frameworkEpoch",
							"gatewayEpoch",
							"protocolVersion",
							"projectionCohortDigest",
							"runtimeEpoch",
							"schemaVersion"
						]
					},
					"agentProjections": {
						"type": "object",
						"minProperties": 1,
						"additionalProperties": {
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"agentId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 256
								},
								"frameworkIdentity": {
									"type": "object",
									"additionalProperties": false,
									"properties": {
										"agentId": {
											"type": "string",
											"minLength": 1,
											"maxLength": 256
										},
										"kind": {
											"const": "openclaw"
										}
									},
									"required": ["agentId", "kind"]
								},
								"profileAssignmentRevision": {
									"type": "string",
									"minLength": 1,
									"maxLength": 256
								},
								"toolPortalNamespaces": {
									"type": "array",
									"items": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"namespace": { "type": "string", "minLength": 1 },
											"summary": { "type": "string", "minLength": 1, "maxLength": 500 }
										},
										"required": ["namespace"]
									},
									"uniqueItems": true
								},
								"toolPortalProfileId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 256
								}
							},
							"required": [
								"agentId",
								"frameworkIdentity",
								"profileAssignmentRevision",
								"toolPortalNamespaces",
								"toolPortalProfileId"
							]
						}
					}
				},
				"required": ["agentProjections", "attachment"]
			}
		},
		"required": ["zoneId"]
	}
}
