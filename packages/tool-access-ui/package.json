{
	"name": "@agent-collaboration/tool-access-ui",
	"version": "0.0.1",
	"description": "Reusable Tool Portal admin panel with a host-neutral view port.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShravanSunder/agent-vm.git",
		"directory": "packages/tool-access-ui"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./fixture": {
			"types": "./dist/panel-fixture.d.ts",
			"import": "./dist/panel-fixture.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown && tailwindcss -i src/panel-theme.css -o dist/styles.css --minify && vite build --config vite.config.ts",
		"preview": "vite preview --config vite.config.ts",
		"dev": "vite --config vite.config.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --root ../../ --config vitest.config.ts --project unit packages/tool-access-ui/src"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.0",
		"lucide-react": "1.59.0",
		"next-themes": "^0.4.6",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jsdom": "^27.4.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"shadcn": "4.22.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "1.4.0",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
}
